<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only access: no Health Connect permissions in release manifest. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <application>
        <activity
            android:name="com.training.trackplanner.health.WatchDiagnosticsActivity"
            android:exported="true"
            android:label="워치 기록 진단 (DEBUG)">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect consent rationale link (Android 13 and older). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission rationale on Android 14+. -->
        <activity-alias
            android:name="com.training.trackplanner.health.WatchP0PermissionUsage"
            android:exported="true"
            android:targetActivity="com.training.trackplanner.health.WatchDiagnosticsActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
