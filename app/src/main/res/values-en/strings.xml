    <string name="app_explanation_intro">WhatYouGottaDo uses your strength-training and badminton records to analyze current fatigue and training balance and help you plan what to do next.</string>
    <string name="app_explanation_limitation_primary">App scores do not represent injury probability or the amount of tissue damage. They are relative metrics for tracking how fatigue and training load change within your own records.</string>
    <string name="app_explanation_limitation_secondary">Prioritize actual symptoms such as pain or instability over app scores.</string>
    <string name="app_explanation_limitation_title">Scores are not diagnoses</string>
