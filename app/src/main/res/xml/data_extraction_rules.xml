<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: apply the same secret exclusion to cloud and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud_auth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud_auth_session.xml" />
    </device-transfer>
</data-extraction-rules>
