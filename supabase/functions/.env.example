# Local-only example. Copy to .env for local function serving and keep the copy untracked.
# The R2 credential must be bucket-scoped Object Read & Write for this bucket only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whatyougottado-backups
